Windows Registry Editor Version 5.00

; ---------- Remove bad overrides (Google Drive etc.) ----------

; PNG
[-HKEY_CURRENT_USER\Software\Classes\.png\shellex\{E357FCCD-A995-4576-B01F-234630154E96}]
[-HKEY_CLASSES_ROOT\.png\shellex\{E357FCCD-A995-4576-B01F-234630154E96}]

; BMP
[-HKEY_CURRENT_USER\Software\Classes\.bmp\shellex\{E357FCCD-A995-4576-B01F-234630154E96}]
[-HKEY_CLASSES_ROOT\.bmp\shellex\{E357FCCD-A995-4576-B01F-234630154E96}]

;-- redirect its broken thumbnail provider to the real Windows one  ----------

[HKEY_CURRENT_USER\Software\Classes\CLSID\{8AD5CECD-DF0D-41C3-BA21-1E22114CC73C}\TreatAs]
@="{C7657C4A-9F68-40fa-A4DF-96BC08EB3551}"

; Also set it system-wide (more reliable)
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{8AD5CECD-DF0D-41C3-BA21-1E22114CC73C}\TreatAs]
@="{C7657C4A-9F68-40fa-A4DF-96BC08EB3551}"

